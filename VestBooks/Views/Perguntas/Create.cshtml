@model Pergunta
@{
    ViewData["Title"] = "Nova Pergunta";
    ViewData["Menu"] = "Perguntas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Voltar para Lista
    </a>
</div>

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Crie uma nova pergunta com alternativas</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="createForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="mb-3">
                        <label asp-for="FaculdadeId" class="form-label">Faculdade</label>
                        <select asp-for="FaculdadeId" class="form-select" asp-items="@(new SelectList(ViewBag.Faculdades, "Id", "Nome"))">
                            <option value="">Selecione uma faculdade</option>
                        </select>
                        <span asp-validation-for="FaculdadeId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Enunciado" class="form-label"></label>
                        <textarea asp-for="Enunciado" class="form-control" rows="5" placeholder="Digite o enunciado da pergunta..."></textarea>
                        <span asp-validation-for="Enunciado" class="text-danger small"></span>
                        <div class="form-text">Use Enter para quebras de linha. O texto será formatado automaticamente.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Alternativas</label>
                        <div class="form-text mb-3">Adicione pelo menos 2 alternativas e marque qual é a correta.</div>
                        
                        <div id="alternativas-container">
                            <div class="alternativa-item mb-3 p-3 border rounded">
                                <div class="row align-items-center">
                                    <div class="col-md-1 text-center">
                                        <div class="form-check">
                                            <input class="form-check-input alternativa-correta" type="radio" name="AlternativaCorreta" value="0" checked>
                                            <label class="form-check-label small">Correta</label>
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <textarea name="Alternativas" class="form-control" rows="2" placeholder="Digite a alternativa A..."></textarea>
                                    </div>
                                    <div class="col-md-1 text-center">
                                        <button type="button" class="btn btn-outline-danger btn-sm remove-alternativa" disabled>
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="alternativa-item mb-3 p-3 border rounded">
                                <div class="row align-items-center">
                                    <div class="col-md-1 text-center">
                                        <div class="form-check">
                                            <input class="form-check-input alternativa-correta" type="radio" name="AlternativaCorreta" value="1">
                                            <label class="form-check-label small">Correta</label>
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <textarea name="Alternativas" class="form-control" rows="2" placeholder="Digite a alternativa B..."></textarea>
                                    </div>
                                    <div class="col-md-1 text-center">
                                        <button type="button" class="btn btn-outline-danger btn-sm remove-alternativa">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="button" id="add-alternativa" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-plus"></i> Adicionar Alternativa
                        </button>
                    </div>

                    <div class="mt-4">
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-success me-md-2">
                                <i class="fas fa-save"></i> Criar Pergunta
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        let alternativaCount = 2;

        // Adicionar nova alternativa
        document.getElementById('add-alternativa').addEventListener('click', function() {
            const container = document.getElementById('alternativas-container');
            const newItem = document.createElement('div');
            newItem.className = 'alternativa-item mb-3 p-3 border rounded';
            newItem.innerHTML = `
                <div class="row align-items-center">
                    <div class="col-md-1 text-center">
                        <div class="form-check">
                            <input class="form-check-input alternativa-correta" type="radio" name="AlternativaCorreta" value="${alternativaCount}">
                            <label class="form-check-label small">Correta</label>
                        </div>
                    </div>
                    <div class="col-md-10">
                        <textarea name="Alternativas" class="form-control" rows="2" placeholder="Digite a alternativa ${String.fromCharCode(65 + alternativaCount)}..."></textarea>
                    </div>
                    <div class="col-md-1 text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-alternativa">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(newItem);
            alternativaCount++;
            
            // Atualizar eventos dos botões de remover
            updateRemoveButtons();
        });

        // Atualizar botões de remover
        function updateRemoveButtons() {
            const removeButtons = document.querySelectorAll('.remove-alternativa');
            const alternativaItems = document.querySelectorAll('.alternativa-item');
            
            removeButtons.forEach((button, index) => {
                // Habilitar/desabilitar botão baseado no número de alternativas
                button.disabled = alternativaItems.length <= 2;
                
                button.onclick = function() {
                    if (alternativaItems.length > 2) {
                        // Verificar se estamos removendo a alternativa correta
                        const item = button.closest('.alternativa-item');
                        const radio = item.querySelector('.alternativa-correta');
                        if (radio.checked) {
                            // Se for a correta, marcar a primeira como correta
                            document.querySelector('.alternativa-correta').checked = true;
                        }
                        
                        item.remove();
                        alternativaCount--;
                        
                        // Reindexar os radios
                        const radios = document.querySelectorAll('.alternativa-correta');
                        radios.forEach((radio, idx) => {
                            radio.value = idx;
                        });
                        
                        updateRemoveButtons();
                    }
                };
            });
        }

        // Inicializar botões de remover
        updateRemoveButtons();

        // Validação do formulário
        document.getElementById('createForm').addEventListener('submit', function(e) {
            const faculdadeId = document.getElementById('FaculdadeId').value;
            const enunciado = document.getElementById('Enunciado').value.trim();
            const alternativas = document.querySelectorAll('textarea[name="Alternativas"]');
            
            let alternativasPreenchidas = 0;
            alternativas.forEach(textarea => {
                if (textarea.value.trim()) {
                    alternativasPreenchidas++;
                }
            });
            
            if (!faculdadeId) {
                e.preventDefault();
                alert('Por favor, selecione uma faculdade.');
                return;
            }
            
            if (!enunciado) {
                e.preventDefault();
                alert('Por favor, preencha o enunciado da pergunta.');
                return;
            }
            
            if (alternativasPreenchidas < 2) {
                e.preventDefault();
                alert('É necessário pelo menos 2 alternativas preenchidas.');
                return;
            }
        });
    </script>
}