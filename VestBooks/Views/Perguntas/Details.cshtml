@model Pergunta
@{
    ViewData["Title"] = "Detalhes da Pergunta";
    ViewData["Menu"] = "Perguntas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <div>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        <a asp-action="Edit" asp-route-id="@Model.PerguntaId" class="btn btn-warning">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.PerguntaId" class="btn btn-danger">Excluir</a>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td class="fw-bold" style="width: 120px;">ID:</td>
                                <td>@Model.PerguntaId</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Faculdade:</td>
                                <td>@Model.Faculdade?.Nome</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <h5>Enunciado:</h5>
                    <div class="card p-3 bg-light">
                        <div style="white-space: pre-line;">@Html.Raw(Model.Enunciado?.Replace("<br>", "\n"))</div>
                    </div>
                </div>

                @if (Model.PerguntaAlternativas?.Any() == true)
                {
                    <div class="mt-4">
                        <h5>Alternativas:</h5>
                        <div class="row">
                            @foreach (var alternativa in Model.PerguntaAlternativas)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card @(alternativa.Correta ? "border-success" : "")">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div style="white-space: pre-line;">@Html.Raw(alternativa.Descricao?.Replace("<br>", "\n"))</div>
                                                @if (alternativa.Correta)
                                                {
                                                    <span class="badge bg-success ms-2">Correta</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>