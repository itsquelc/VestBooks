@model List<Pergunta>
@{
    ViewData["Title"] = "Perguntas";
    ViewData["Menu"] = "Perguntas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nova Pergunta
    </a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Lista de Perguntas</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Enunciado</th>
                            <th>Faculdade</th>
                            <th>Alternativas</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pergunta in Model)
                        {
                            <tr>
                                <td>@pergunta.PerguntaId</td>
                                <td>
                                    <span class="text-truncate-2" style="max-width: 300px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @Html.Raw(pergunta.Enunciado?.Replace("<br>", " "))
                                    </span>
                                </td>
                                <td>@pergunta.Faculdade?.Nome</td>
                                <td>
                                    <span class="badge bg-info">@pergunta.PerguntaAlternativas.Count</span>
                                    @if (pergunta.PerguntaAlternativas.Any(a => a.Correta))
                                    {
                                        <span class="badge bg-success ms-1">Correta: ✓</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@pergunta.PerguntaId" 
                                           class="btn btn-info btn-sm" title="Detalhes">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@pergunta.PerguntaId" 
                                           class="btn btn-warning btn-sm" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@pergunta.PerguntaId" 
                                           class="btn btn-danger btn-sm" title="Excluir">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                <h4>Nenhuma pergunta encontrada</h4>
                <p class="text-muted">Não há perguntas cadastradas no sistema.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Cadastrar Primeira Pergunta
                </a>
            </div>
        }
    </div>
</div>