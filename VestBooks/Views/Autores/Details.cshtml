@model Autor
@{
    ViewData["Title"] = "Detalhes do Autor";
    ViewData["Menu"] = "Autores";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <div>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        <a asp-action="Edit" asp-route-id="@Model.AutorId" class="btn btn-warning">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.AutorId" class="btn btn-danger">Excluir</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.Foto))
        {
            <img src="@Model.Foto" class="img-fluid rounded shadow" alt="@Model.Nome">
        }
        else
        {
            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 300px;">
                <i class="fas fa-user fa-5x text-muted"></i>
            </div>
        }
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">@Model.Nome</h3>
                <hr>
                
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td class="fw-bold" style="width: 120px;">ID:</td>
                                <td>@Model.AutorId</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Nome:</td>
                                <td>@Model.Nome</td>
                            </tr>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Biografia))
                {
                    <div class="mt-3">
                        <h5>Biografia:</h5>
                        <p class="card-text">@Model.Biografia</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>