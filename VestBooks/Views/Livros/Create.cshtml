@model Livro
@{
    ViewData["Title"] = "Novo Livro";
    ViewData["Menu"] = "Livros";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Voltar para Lista
    </a>
</div>

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Preencha os dados do livro</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Nome" class="form-label"></label>
                                <input asp-for="Nome" class="form-control" placeholder="Digite o nome do livro" />
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="AutorId" class="form-label">Autor</label>
                                <select asp-for="AutorId" class="form-select" asp-items="@(new SelectList(ViewBag.Autores, "AutorId", "Nome"))">
                                    <option value="">Selecione um autor</option>
                                </select>
                                <span asp-validation-for="AutorId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Faculdades</label>
                                <select name="FaculdadeIds" class="form-select" multiple size="4" id="faculdadesSelect">
                                    @foreach (var faculdade in ViewBag.Faculdades)
                                    {
                                        <option value="@faculdade.Id">@faculdade.Nome</option>
                                    }
                                </select>
                                <div class="form-text">
                                    Segure Ctrl (Windows) ou Command (Mac) para selecionar múltiplas faculdades.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="Publicacao" class="form-label"></label>
                                <input asp-for="Publicacao" class="form-control" placeholder="Ex: 2024" maxlength="4" />
                                <span asp-validation-for="Publicacao" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="Avaliacao" class="form-label"></label>
                                <input asp-for="Avaliacao" class="form-control" placeholder="Ex: 8.5" maxlength="3" />
                                <span asp-validation-for="Avaliacao" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="NumeroPaginas" class="form-label">Número de Páginas</label>
                                <input asp-for="NumeroPaginas" class="form-control" type="number" min="1" />
                                <span asp-validation-for="NumeroPaginas" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3 form-check">
                                <input asp-for="Destaque" class="form-check-input" />
                                <label asp-for="Destaque" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Video" class="form-label">Vídeo (YouTube)</label>
                        <input asp-for="Video" class="form-control" placeholder="ID do vídeo do YouTube" />
                        <span asp-validation-for="Video" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label"></label>
                        <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Descrição breve do livro..."></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Resumo" class="form-label"></label>
                        <textarea asp-for="Resumo" class="form-control" rows="6" placeholder="Resumo completo do livro..."></textarea>
                        <span asp-validation-for="Resumo" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Capa do Livro</label>
                                <input type="file" name="foto" class="form-control" accept="image/*" id="fotoInput" />
                                <div class="form-text">Formatos suportados: JPG, PNG, GIF. Tamanho máximo: 5MB.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">PDF do Livro</label>
                                <input type="file" name="pdf" class="form-control" accept=".pdf" id="pdfInput" />
                                <div class="form-text">Apenas arquivos PDF. Tamanho máximo: 10MB.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Preview da imagem -->
                    <div class="mb-3" id="imagePreviewContainer" style="display: none;">
                        <label class="form-label">Pré-visualização da Capa:</label>
                        <div class="border rounded p-3 text-center">
                            <img id="imagePreview" class="img-fluid rounded" style="max-height: 200px;" />
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearImage()">
                                    <i class="fas fa-times"></i> Remover Imagem
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-success me-md-2">
                                <i class="fas fa-save"></i> Criar Livro
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        // Preview da imagem selecionada
        document.getElementById('fotoInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const previewContainer = document.getElementById('imagePreviewContainer');
            const preview = document.getElementById('imagePreview');
            
            if (file) {
                // Validar tamanho do arquivo (5MB)
                const fileSize = file.size / 1024 / 1024;
                if (fileSize > 5) {
                    alert('O arquivo é muito grande. Tamanho máximo permitido: 5MB');
                    e.target.value = '';
                    previewContainer.style.display = 'none';
                    return;
                }
                
                // Validar tipo do arquivo
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                if (!validTypes.includes(file.type)) {
                    alert('Tipo de arquivo não suportado. Use apenas imagens JPG, PNG ou GIF.');
                    e.target.value = '';
                    previewContainer.style.display = 'none';
                    return;
                }
                
                // Mostrar preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    previewContainer.style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                previewContainer.style.display = 'none';
            }
        });

        // Validação do PDF
        document.getElementById('pdfInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            
            if (file) {
                // Validar tamanho do arquivo (10MB)
                const fileSize = file.size / 1024 / 1024;
                if (fileSize > 10) {
                    alert('O arquivo PDF é muito grande. Tamanho máximo permitido: 10MB');
                    e.target.value = '';
                    return;
                }
                
                // Validar tipo do arquivo
                if (file.type !== 'application/pdf') {
                    alert('Tipo de arquivo não suportado. Use apenas arquivos PDF.');
                    e.target.value = '';
                    return;
                }
            }
        });

        // Limpar imagem selecionada
        function clearImage() {
            document.getElementById('fotoInput').value = '';
            document.getElementById('imagePreviewContainer').style.display = 'none';
        }

        // Validação do formulário antes do envio
        document.getElementById('createForm').addEventListener('submit', function(e) {
            const nome = document.getElementById('Nome').value.trim();
            const autorId = document.getElementById('AutorId').value;
            const faculdadesSelect = document.getElementById('faculdadesSelect');
            const faculdadesSelecionadas = Array.from(faculdadesSelect.selectedOptions).map(option => option.value);
            
            if (!nome) {
                e.preventDefault();
                alert('Por favor, preencha o nome do livro.');
                return;
            }
            
            if (!autorId) {
                e.preventDefault();
                alert('Por favor, selecione um autor.');
                return;
            }
            
            if (faculdadesSelecionadas.length === 0) {
                e.preventDefault();
                alert('Por favor, selecione pelo menos uma faculdade.');
                return;
            }
        });
    </script>
}