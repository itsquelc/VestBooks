@model List<Livro>
@{
    ViewData["Title"] = "Livros";
    ViewData["Menu"] = "Livros";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Novo Livro
    </a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Lista de Livros</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Capa</th>
                            <th>Nome</th>
                            <th>Autor</th>
                            <th>Faculdades</th>
                            <th>Publicação</th>
                            <th>Destaque</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var livro in Model)
                        {
                            <tr>
                                <td>@livro.LivroId</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(livro.Foto))
                                    {
                                        <img src="@livro.Foto" alt="@livro.Nome" 
                                             class="img-thumbnail" style="width: 60px; height: 80px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                                             style="width: 60px; height: 80px;">
                                            <i class="fas fa-book text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>@livro.Nome</td>
                                <td>@livro.Autor?.Nome</td>
                                <td>
                                    @if (livro.Faculdades?.Any() == true)
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var faculdadeLivro in livro.Faculdades.Take(3))
                                            {
                                                <span class="badge bg-primary">@faculdadeLivro.Faculdade.Nome</span>
                                            }
                                            @if (livro.Faculdades.Count > 3)
                                            {
                                                <span class="badge bg-secondary">+@(livro.Faculdades.Count - 3)</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nenhuma</span>
                                    }
                                </td>
                                <td>@livro.Publicacao</td>
                                <td>
                                    @if (livro.Destaque)
                                    {
                                        <span class="badge bg-success">Sim</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Não</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@livro.LivroId" 
                                           class="btn btn-info btn-sm" title="Detalhes">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@livro.LivroId" 
                                           class="btn btn-warning btn-sm" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@livro.LivroId" 
                                           class="btn btn-danger btn-sm" title="Excluir">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-book fa-3x text-muted mb-3"></i>
                <h4>Nenhum livro encontrado</h4>
                <p class="text-muted">Não há livros cadastrados no sistema.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Cadastrar Primeiro Livro
                </a>
            </div>
        }
    </div>
</div>