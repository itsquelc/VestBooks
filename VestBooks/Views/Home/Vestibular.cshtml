@model Faculdade
@{
  ViewData["Title"] = Model.Nome;
}

<section class="bg-white mt-100">
  <div class="container-fluid px-0">
    <div class="bg-primary py-4">
      <div class="container text-center">
        <img src="@Model.Foto" alt="Logo" class="img-fluid" style="max-height: 60px; ">
      </div>
    </div>
    <div class="container mt-5 text-center">
      <div class="row featurette">
        <div class="col-mt-12">
          <p class="lead">@Html.Raw(Model.Descricao)
          </p>
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <div class="text-center bg-info text-white py-2 my-4" style="font-weight: bold;">
        Livros
      </div>

      <div class="row">
        <div class="col">
          <div id="livros" class="livro mt-3 p-2">
            @foreach (var livro in Model.Livros) {
              <a href='#'><img src="@livro.Livro.Foto" alt="@livro.Livro.Nome"></a>
            }
          </div>
        </div>
      </div>
    </div>
    <div class="text-center bg-info text-white py-2 my-4" style="font-weight: bold;">
    Autores
</div>
<div class="row">
    <div id="autor" class="autor mt-3 p-2 ">
        @foreach (var livro in Model.Livros)
        {
            <div class="text-center d-inline-block m-2">
                <a href="#">
                    <img src="@livro.Livro.Autor.Foto" alt="@livro.Livro.Autor.Nome" style="width:220px; height:300px; object-fit:cover;" />
                </a>
                <div class="mt-1 fw-bold text-center">@livro.Livro.Autor.Nome</div>
            </div>
        }
    </div>
</div>

      <div class="text-center bg-info text-white py-2 my-5" style="font-weight: bold;">
        Vídeo Aula
      </div>

      <div class="row justify-content-center mb-5">
        <div class="col-md-8">
          <div class="row">
            <!-- Vídeo principal -->
            <div class="col-md-9 mb-3">
              <div class="ratio ratio-16x9">
                <iframe id="mainVideo" src="https://www.youtube.com/embed/oxpXwPhc6Lo" allowfullscreen></iframe>
              </div>
            </div>

            <!-- Lista de vídeos com scroll -->
            <div style="width: 200px;" class="d-flex align-items-center">
              <div class="video-list w-100">
                <div class="video-thumbnail" onclick="changeVideo('rnpUJvVpngY')">
                  <img src="https://img.youtube.com/vi/rnpUJvVpngY/0.jpg" alt="Vídeo 1">
                </div>
                <div class="video-thumbnail" onclick="changeVideo('M8h-WXKyLFc')">
                  <img src="https://img.youtube.com/vi/M8h-WXKyLFc/0.jpg" alt="Vídeo 2">
                </div>
                <div class="video-thumbnail" onclick="changeVideo('mKR1Vkqxyjo')">
                  <img src="https://img.youtube.com/vi/mKR1Vkqxyjo/0.jpg" alt="Vídeo 3">
                </div>
                <div class="video-thumbnail" onclick="changeVideo('Rfgy_g79ww4')">
                  <img src="https://img.youtube.com/vi/Rfgy_g79ww4/0.jpg" alt="Vídeo 4">
                </div>
                <div class="video-thumbnail" onclick="changeVideo('V1s1a77PnOg')">
                  <img src="https://img.youtube.com/vi/V1s1a77PnOg/0.jpg" alt="Vídeo 5">
                  <div class="video-thumbnail" onclick="changeVideo('GyXglxNR5Ss')">
                    <img src="https://img.youtube.com/vi/GyXglxNR5Ss/0.jpg" alt="Vídeo 6">
                  </div>
                  <div class="video-thumbnail" onclick="changeVideo('Yac_R3PlFeE')">
                    <img src="https://img.youtube.com/vi/Yac_R3PlFeE/0.jpg" alt="Vídeo 7">
                  </div>
                  <div class="video-thumbnail" onclick="changeVideo('Cv-7AH2wTQQ')">
                    <img src="https://img.youtube.com/vi/Cv-7AH2wTQQ/0.jpg" alt="Vídeo 8">
                  </div>
                  <div class="video-thumbnail" onclick="changeVideo('CWagtQP7hqw')">
                    <img src="https://img.youtube.com/vi/CWagtQP7hqw/0.jpg" alt="Vídeo 9">
                  </div>
                  <div class="video-thumbnail" onclick="changeVideo('465n-yZqt6I')">
                    <img src="https://img.youtube.com/vi/465n-yZqt6I/0.jpg" alt="Vídeo 10">
                  </div>
                  <div class="video-thumbnail" onclick="changeVideo('v6rjjpbeNBk')">
                    <img src="https://img.youtube.com/vi/v6rjjpbeNBk/0.jpg" alt="Vídeo 11">
                  </div>

                </div>
              </div>
            </div>
          </div>

          <h4 class="text-center bg-primary text-white py-2 my-4">COMO É COBRADO?</h4>

          <div class="bg-white shadow rounded p-4 mt-3">
            <p class="text-center fw-bold">@Model.Nome</p>
            <p>@Html.Raw(Model.Perguntas[0].Enunciado)</p>

            <p>No trecho citado, o autor representa uma situação desencantada da mulher brasileira dos anos
              1940,
              tratando com humor a sensualidade e os conflitos sociais que envolvem essa época.</p>

            <div id="quiz-options" class="mt-4">
              <div class="quiz-option border rounded p-2 mb-2" onclick="checkAnswer(this, 'A')">A) Relata a vida
                feliz e harmoniosa de mulheres da década de 1940, demonstrando que não havia disposição em
                superar
                essa época.</div>
              <div class="quiz-option border rounded p-2 mb-2" onclick="checkAnswer(this, 'B')">B) Mostra um
                posicionamento progressista e feminista do autor diante da condição da mulher no século XXI.
              </div>
              <div class="quiz-option border rounded p-2 mb-2" onclick="checkAnswer(this, 'C')">C) Denuncia a
                falta de comprometimento e a desvalorização das mulheres, que eram excluídas dos espaços sociais
                e
                políticos.</div>
              <div class="quiz-option border rounded p-2 mb-2" onclick="checkAnswer(this, 'D')">D) Mantém o
                distanciamento narrativo coerente com sua posição social, de espectador da forma.</div>
            </div>

            <div id="feedback" class="mt-3 fw-bold text-center"></div>
            <div class="text-center mt-4">
              <a asp-action= "Perguntas" asp-controller ="Home" class="btn btn-primary">Clique aqui para mais perguntas</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
