@model Faculdade
@{
    ViewData["Title"] = Model.Nome;
    string[] letras = ["A", "B", "C", "D", "E", "F"];
    Random random = new Random();
    int pergunta = random.Next(Model.Perguntas.Count);
    int alternativas = Model.Perguntas[pergunta].PerguntaAlternativas.Count();
}

@if (Model.Livros.Count > 0)
{
<section class="bg-white mt-100">
    <div class="container-fluid px-0">

        <div class='@(Model.Id != 3 ? "bg-primary" : "bg-pink") py-4'>
            <div class="container text-center">
                <img src="@Model.Foto" alt="Logo" class="img-fluid" style="max-height: 60px;">
            </div>
        </div>

        <div class="container mt-5 text-center">
            <div class="row featurette">
                <div class="col-mt-12">
                    <p class="lead">@Html.Raw(Model.Descricao)</p>
                </div>
            </div>
        </div>

        @if (Model.Id == 3)
        {
            <div class="pink-container" style="height: unset !important;">
                <div class="container-text" style="max-width: unset !important; width: 100%; margin: 50px 120px">
                    <p class="lead py-4">As questões de Literatura representam cerca de 30% das questões de Português, considerando as duas fases do processo seletivo da Fuvest.</p>
                    <p class="lead py-4">Em 2026, foi divulgada a nova lista de leitura obrigatória que é composta somente por mulheres autoras de língua portuguesa brasileiras e estrangeiras.</p>
                </div>
            </div>
        }

        <!-- LIVROS -->
        <div class="row mt-4">
            <div class="text-center @(Model.Id == 3 ? "bg-info-pink" : "bg-info") text-white py-2 my-4" style="font-weight: bold;">
                Livros
            </div>

            <div class="row">
                <div class="col">
                    <div id="livros" class="livro mt-3 p-2">
                        @foreach (var livro in Model.Livros)
                        {
                            <a asp-action="Livro" asp-controller="Home" asp-route-id="@livro.LivroId">
                                <img src="@livro.Livro.Foto" alt="@livro.Livro.Nome">
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- AUTORES -->
        <div class="text-center @(Model.Id == 3 ? "bg-info-pink" : "bg-info") text-white py-2 my-4" style="font-weight: bold;">
            Autores
        </div>

        <div class="row">
            <div id="autor" class="autor mt-3 p-2">
                @foreach (var livro in Model.Livros)
                {
                    <div class="text-center d-inline-block m-2">
                        <a href="#">
                            <img src="@livro.Livro.Autor.Foto" alt="@livro.Livro.Autor.Nome"
                                 style="width:220px; height:300px; object-fit:cover;" />
                        </a>
                        <div class="mt-1 fw-bold">@livro.Livro.Autor.Nome</div>
                    </div>
                }
            </div>
        </div>

        <!-- VIDEO AULA -->
        <div class="text-center @(Model.Id == 3 ? "bg-info-pink" : "bg-info") text-white py-2 my-5" style="font-weight: bold;">
            Vídeo Aula
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-md-8">
                <div class="row">
                    <!-- Vídeo principal -->
                    <div class="col-md-9 mb-3">
                        <div class="ratio ratio-16x9">
                            <iframe id="mainVideo" src="https://www.youtube.com/embed/@Model.Livros[0].Livro.Video"
                                    allowfullscreen></iframe>
                        </div>
                    </div>

                    <!-- Lista de vídeos -->
                    <div style="width: 200px;" class="d-flex align-items-center">
                        <div class="video-list w-100">
                            @foreach (var livro in Model.Livros)
                            {
                                <div class="video-thumbnail" onclick="changeVideo('@livro.Livro.Video')">
                                    <img src="https://img.youtube.com/vi/@livro.Livro.Video/0.jpg" alt="Vídeo do livro @livro.Livro.Nome">
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- COMO É COBRADO -->
                <h4 class="text-center @(Model.Id == 3 ? "bg-pink" : "bg-primary") text-white py-2 my-4">
                    COMO É COBRADO?
                </h4>

                <!-- QUIZ CORRIGIDO -->
                <div class="bg-white shadow rounded p-4 mt-3">
                    <p class="text-center fw-bold">@Model.Nome</p>
                    <p>@Html.Raw(Model.Perguntas[pergunta].Enunciado)</p>

                    <div id="quiz-options" class="mt-4">
                        @for (int i = 0; i < alternativas; i++)
                        {
                            var alt = Model.Perguntas[pergunta].PerguntaAlternativas[i];

                            <div class="quiz-option border rounded p-2 mb-2"
                                 data-correct="@(alt.Correta.ToString().ToLower())"
                                 onclick="checkAnswer(this)">
                                @letras[i]) @alt.Descricao
                            </div>
                        }
                    </div>

                    <div id="feedback" class="mt-3 fw-bold text-center"></div>

                    <div class="text-center mt-4">
                        <a asp-action="Perguntas" asp-controller="Home" asp-route-id="@Model.Id"
                           class="btn @(Model.Id == 3 ? "btn-pink" : "btn-primary")">
                            Clique aqui para mais perguntas
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
}
else
{
<section class="bg-white mt-100">
    <div class="container-fluid px-0">
        <div class="bg-primary py-4">
            <div class="container text-center">
                <img src="@Model.Foto" alt="Logo" class="img-fluid" style="max-height: 60px;">
            </div>
        </div>

        <div class="container mt-5 text-center">
            <div class="row featurette">
                <div class="col-mt-12">
                    <p class="lead">@Html.Raw(Model.Descricao)</p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-md-8">

                <div class="bg-white shadow rounded p-4 mt-3">
                    <p class="text-center fw-bold">@Model.Nome</p>
                    <p>@Html.Raw(Model.Perguntas[pergunta].Enunciado)</p>

                    <div id="quiz-options" class="mt-4">
                        @for (int i = 0; i < alternativas; i++)
                        {
                            var alt = Model.Perguntas[pergunta].PerguntaAlternativas[i];

                            <div class="quiz-option border rounded p-2 mb-2"
                                 data-correct="@(alt.Correta.ToString().ToLower())"
                                 onclick="checkAnswer(this)">
                                @letras[i]) @alt.Descricao
                            </div>
                        }
                    </div>

                    <div id="feedback" class="mt-3 fw-bold text-center"></div>

                    <div class="text-center mt-4">
                        <a asp-action="Perguntas" asp-controller="Home" asp-route-id="@Model.Id" class="btn btn-primary">
                            Clique aqui para mais perguntas
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
}


