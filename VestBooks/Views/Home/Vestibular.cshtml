@model Faculdade
@{
    ViewData["Title"] = Model.Nome;
    string[] letras = ["A", "B", "C", "D", "E", "F"];
    Random random = new Random();
    int pergunta = Model.Perguntas.Count > 0 ? random.Next(Model.Perguntas.Count) : 0;
    int alternativas = Model.Perguntas.Count > 0 ? Model.Perguntas[pergunta].PerguntaAlternativas.Count() : 0;
    var autores = Model.Livros.Count > 0 ? Model.Livros.Select(l => l.Livro.Autor).Distinct() : null;
    ViewData["bgInfo"] = Model.Id == 3 ? "bg-info-pink" : "bg-info";
    ViewData["bgBlue"] = Model.Id == 3 ? "bg-pink" : "bg-blue";
}

<section class="bg-white mt-100">
    <!-- mantém px-0 para as faixas encostarem na borda -->
    <div class="container-fluid px-0">

        <!-- FAIXA SUPERIOR -->
        <div class="@ViewBag.bgBlue py-4">
            <div class="d-flex justify-content-center align-items-center container text-center">

                <span class="text-white ms-4 display-4 fw-bold">@Model.Nome</span>
            </div>
        </div>

        <!-- DESCRIÇÃO -->
        <div class="container mt-5 text-center">
            <div class="row featurette">
                <div class="col-md-4 d-flex align-items-center">
                    <img src="@Model.Foto" alt="Logo" class="img-fluid w-100">
                </div>
                <div class="col-md-8">
                    <p class="lead quebra">@Html.Raw(Model.Descricao)</p>
                </div>
            </div>
        </div>

        @if (Model.Id == 3)
        {
            <div class="pink-container mt-5" style="height: unset !important;">
                <div class="container my-5 text-white">
                    <p class="lead pt-4 pb-3">
                        As questões de Literatura representam cerca de 30% das questões de Português,
                        considerando as duas fases do processo seletivo da Fuvest.
                    </p>
                    <p class="lead pb-4">
                        Em 2026, foi divulgada a nova lista de leitura obrigatória que é composta somente
                        por mulheres autoras de língua portuguesa brasileiras e estrangeiras.
                    </p>
                </div>
            </div>
        }

        @if (Model.Livros.Count > 0)
        {
            <!-- LIVROS (faixa full-width) -->
            <h4 class="text-center @ViewBag.bgInfo text-white py-2 my-5 fw-bold">
                Livros
            </h4>

            <!-- LIVROS (conteúdo dentro de container pra não dar overflow) -->
            <div class="container mb-5">
                <div class="row px-0">
                    <div class="col">
                        <div id="livros" class="livro mt-1 p-2 ps-4">
                            @foreach (var livro in Model.Livros)
                            {
                                <a asp-action="Livro" asp-controller="Home" asp-route-id="@livro.LivroId">
                                    <img src="@livro.Livro.Foto" alt="@livro.Livro.Nome">
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- AUTORES (faixa full-width) -->
            <h4 class="text-center @ViewBag.bgInfo text-white py-2 my-5 fw-bold">
                Autores
            </h4>

            <!-- AUTORES (conteúdo em container + row/col certinhos) -->
            <div class="container">
                <div class="row">
                    <div class="col">
                        <div id="autor" class="autor mt-1 ps-4 p-2">
                            @foreach (var autor in autores)
                            {
                                <div class="text-center d-inline-block">
                                    <a asp-action="Autor" asp-controller="Home" asp-route-id="@autor.AutorId">
                                        <img src="@autor.Foto" alt="@autor.Nome" />
                                    </a>
                                    <div class="mt-1 fw-bold">@autor.Nome</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Livros[0].Livro.Video != null)
            {
                <!-- VÍDEO AULA (faixa full-width) -->
                <h4 class="text-center @ViewBag.bgInfo text-white py-2 my-5 fw-bold">
                    Vídeo Aula
                </h4>

                <!-- VÍDEO AULA (conteúdo em container) -->
                <div class="container">
                    <div class="row justify-content-center mb-5">
                        <div class="col-md-9">
                            <div class="row">
                                <!-- Vídeo principal -->
                                <div class="col-md-9 mb-3">
                                    <div class="ratio ratio-16x9">
                                        <iframe id="mainVideo" src="https://www.youtube.com/embed/@Model.Livros[0].Livro.Video"
                                            allowfullscreen></iframe>
                                    </div>
                                </div>

                                <!-- Lista de vídeos -->
                                <div class="col-md-3 d-flex align-items-center">
                                    <div class="video-list w-100">
                                        @foreach (var livro in Model.Livros)
                                        {
                                            <div class="video-thumbnail" onclick="changeVideo('@livro.Livro.Video')">
                                                <img src="https://img.youtube.com/vi/@livro.Livro.Video/0.jpg"
                                                    alt="Vídeo do livro @livro.Livro.Nome">
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <h4 class="text-center @ViewBag.bgInfo text-white py-5 my-5 fw-bold">
                OS LIVROS ESTÃO CHEGANDO
            </h4>
        }

        @if (Model.Perguntas.Count > 0)
        {
            <!-- TESTE DE CONHECIMENTO (faixa full-width) -->
            <h4 class="text-center @ViewBag.bgInfo text-white py-2 my-4 fw-bold">
                Teste de Conhecimento
            </h4>

            <!-- TESTE DE CONHECIMENTO (conteúdo em container) -->
            <div class="container">
                <div class="row justify-content-center mb-5">
                    <div class="col-md-9">
                        <div class="row">
                            <div class="bg-white shadow rounded p-4 mt-3">
                                <p class="text-center fw-bold">@Model.Nome</p>
                                <p class="quebra">@Html.Raw(Model.Perguntas[pergunta].Enunciado)</p>

                                <div id="quiz-options" class="mt-4">
                                    @for (int i = 0; i < alternativas; i++)
                                    {
                                        var alt = Model.Perguntas[pergunta].PerguntaAlternativas[i];
                                        <div class="quiz-option border rounded-2 p-3 mb-2"
                                            data-correct="@(alt.Correta.ToString().ToLower())" onclick="checkAnswer(this)">
                                            <span class="quebra">@letras[i]) @alt.Descricao</span>
                                        </div>
                                    }
                                </div>

                                <div id="feedback" class="mt-3 fw-bold text-center"></div>

                                <div class="text-center mt-4">
                                    <a asp-action="Perguntas" asp-controller="Home" asp-route-id="@Model.Id"
                                        class="btn @(Model.Id == 3 ? "btn-pink" : "btn-primary") w-100 p-3 fs-5">
                                        Clique aqui para mais perguntas
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <h4 class="text-center @ViewBag.bgInfo text-white py-5 my-5 fw-bold">
                NOVOS TESTES ESTARÃO DISPONÍVEIS EM BREVE
            </h4>
        }
    </div>
</section>