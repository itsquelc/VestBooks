@model Faculdade
@{
  ViewData["Title"] = Model.Nome;
  string[] letras = ["A", "B", "C", "D", "E", "F"];
}

<section class="bg-white mt-100">
  <div class="container-fluid px-0">
    <div class="bg-primary py-4">
      <div class="container text-center">
        <img src="@Model.Foto" alt="Logo" class="img-fluid" style="max-height: 60px; ">
      </div>
    </div>
    <div class="container mt-5 text-center">
      <div class="row featurette">
        <div class="col-mt-12">
          <p class="lead">@Html.Raw(Model.Descricao)</p>
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <div class="text-center bg-info text-white py-2 my-4" style="font-weight: bold;">
        Perguntas
      </div>

      <div class="container">
        @foreach (var pergunta in Model.Perguntas)
        {
          <div class="container container-pergunta">
            <div class="header text-center">
              @Model.Nome
            </div>
            <div class="question-text">
              <p>@Html.Raw(pergunta.Enunciado)</p>
            </div>

            <div id="quiz-options" class="options">
              @for(int i = 0; i < pergunta.PerguntaAlternativas.Count(); i++)
              {
                <div class="list-group-item" data-option="@letras[i]" data-correct="@pergunta.PerguntaAlternativas[i].Correta">
                  <span class="option-letter">@letras[i]</span>
                  @pergunta.PerguntaAlternativas[i].Descricao
                </div>
              }
            </div>

            <div id="feedbackMessage" class="feedback-message"></div>

          </div>
        }
      </div>
    </div>
  </div>
</section>