@model Faculdade
@{
    ViewData["Title"] = "Perguntas";
}

<section class="bg-white mt-100">
  <div class="container-fluid px-0">
    <div class="bg-primary py-4">
      <div class="container text-center">
        <img src="@Model.Foto" alt="Logo" class="img-fluid" style="max-height: 60px; ">
      </div>
    </div>
    <div class="container mt-5 text-center">
      <div class="row featurette">
        <div class="col-mt-12">
          <p class="lead">@Html.Raw(Model.Descricao)
          </p>
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <div class="text-center bg-info text-white py-2 my-4" style="font-weight: bold;">
        Perguntas
      </div>

        <div id="perguntas" class="pergunta mt-3 p-2">
              @foreach (var faculdade in Model.Faculdades)
        {
            <div class="text-center d-inline-block m-2">
                <a href="#">
                    <img src="@faculdade.Faculdade.Pergunta" alt="@faculdade.Faculdade.Pergunta.Enunciado" style="width:220px; height:300px; object-fit:cover;" />
                </a>
        }
            </div>
</section> 