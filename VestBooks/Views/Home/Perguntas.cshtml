@model Faculdade
@{
  ViewData["Title"] = Model.Nome;
  string[] letras = ["A", "B", "C", "D", "E", "F"];
  ViewData["bgInfo"] = Model.Id == 3 ? "bg-info-pink" : "bg-info";
  ViewData["bgBlue"] = Model.Id == 3 ? "bg-pink" : "bg-blue";
}

<div class="container-fluid w-100">
  <div class="row">
    <!-- Lado esquerdo -->
    <div class="col-1 col-md-2 @ViewBag.bgBlue"></div>

    <div class="col-10 col-md-8 content mt-5">
      <div class="@ViewBag.bgBlue py-4">
        <div class="d-flex justify-content-center align-items-center container text-center">
          <img src="@Model.Foto" alt="Logo" class="img-fluid" style="max-height: 70px;">
          <span class="text-white ms-4 display-4 fw-bold">@Model.Nome</span>
        </div>
      </div>

      <div class="container mt-5 text-center">
        <div class="row featurette">
          <div class="col-mt-12">
            <p class="lead quebra">@Html.Raw(Model.Descricao)</p>
          </div>
        </div>
      </div>

      <div class="row mt-4">
        <div class="col">
          <h4 class="text-center @ViewBag.bgInfo text-white py-2 my-4 mb-0 fw-bold">
            Perguntas
          </h4>
        </div>

        <div class="container">
          @foreach (var pergunta in Model.Perguntas)
          {
            <div class="container container-pergunta">
              <div class="header text-center @ViewBag.bgBlue">
                @Model.Nome
              </div>
              <div class="question-text @ViewBag.bgInfo">
                <p class="quebra">@Html.Raw(pergunta.Enunciado)</p>
              </div>

              <div class="options">
                @for (int i = 0; i < pergunta.PerguntaAlternativas.Count(); i++)
                {
                  var alt = pergunta.PerguntaAlternativas[i];

                  <div class="quiz-option list-group-item" data-option="@letras[i]"
                    data-correct="@(alt.Correta.ToString().ToLower())" onclick="checkAnswer(this)">
                    <span class="option-letter @ViewBag.bgBlue">@letras[i]</span>
                    <span class="quebra">@alt.Descricao</span>
                  </div>
                }
              </div>

              <div class="feedback-message"></div>
            </div>
          }
        </div>
      </div>
    </div>

    <!-- Lado direito -->
    <div class="col-1 col-md-2 @ViewBag.bgBlue"></div>
  </div>
</div>


@section Scripts {
  <script src="~/js/perguntas.js"></script>
}