@model HomeVM
@{
  ViewData["Title"] = "Home";
}

<div id="carousel" class="carousel carousel-fade slide bg-dark" data-bs-ride="carousel" data-bs-interval="4000"
  data-bs-pause="false">
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#carousel" data-bs-slide-to="0" class="active" aria-current="true"
      aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#carousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#carousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
  </div>
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img src="img/foto1.png" class="d-block w-100 opacity-25" alt="...">
      <div class="carousel-caption">
        <div class="logoinicio">
          <img src="img/logo horizontal.png">
          <p>"O melhor conteúdo, a sua melhor preparação."</p>
        </div>
      </div>
    </div>
    <div class="carousel-item">
      <img src="img/foto2.png" class="d-block w-100 opacity-25" alt="...">
      <div class="carousel-caption">
        <div class="logoinicio">
          <img src="img/logo horizontal.png">
          <p>"O melhor conteúdo, a sua melhor preparação."</p>
        </div>
      </div>
    </div>
    <div class="carousel-item">
      <img src="img/foto3.png" class="d-block w-100 opacity-25" alt="...">
      <div class="carousel-caption">
        <div class="logoinicio">
          <img src="img/logo horizontal.png">
          <p>"O melhor conteúdo, a sua melhor preparação."</p>
        </div>
      </div>
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carousel" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>

<div id="sobre" style="height: 100px;"></div>

<div class="container py-5 bg-white">
  <div class="row featurette">
    <div class="col-md-9">
      <h2 class="featurette-heading fw-normal lh-1">Quem somos</h2>
      <p class="lead">Nos chamamos Laura, Raquel,Louise e Amanda.
        Esse é um site com informações sobre livros importantes para os vestibulares do estado de São Paulo.
        Aqui você encontrará videoaulas, resumos, questões e análises de obras fundamentais para os vestibulares.
        Queremos ajudar os estudantes a se prepararem de forma eficiente e prazerosa para as provas, tornando o
        caminho do vestibular mais tranquilo e enriquecedor. Junte-se a nós nessa jornada pelo mundo da leitura e do
        aprendizado.
      </p>
    </div>
    <div class="col-md-2">
      <img src="img/Amigas.png" class="img-fluid">
    </div>
  </div>
</div>

<div class="container bg-white pt-4">
  <div class="container">
    <div class="text-center bg-info text-white py-2 fw-bold">
      VESTIBULARES
    </div>
  </div>

  <div class="row px-0">
    <div class="col">
      <div id="livros" class="rowLivro my-3">
        <div class="rowLivro-inner">
          @foreach (var faculdade in Model.Faculdades)
          {
            <a asp-action="Vestibular" asp-route-id="@faculdade.Id" class="livro-item">
              <img src="@faculdade.Foto" alt="@faculdade.Nome">
            </a>
          }
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container bg-white">
  <div class="text-center bg-info text-white py-2 pw-bold">
    Você sabia que os livros da FUVEST mudaram?
  </div>
  <div class="row featurette">
    <div class="col-md-4 p-0 my-3">
      <img src="~/img/ALUÍSIOREITOR.png" class="img-fluid">
    </div>

    <div class="col-md-7 p-0">
      <p class="lead"><br><br> Essa mudança vai se estender até 2028, a partir de 2029, autores da literatura
        brasileira
        e de língua portuguesa voltam a aparecer na lista: Machado de Assis, Érico Veríssimo e Luís Bernardo Honwana
        foram os escolhidos. Este será um ano em que a lista conterá quatro obras escritas por autoras e autores
        negros
      </p>

      <p class="lead"> Além disso, Incidente em Antares, de Érico Veríssimo, foi uma obra escolhida por se
        tratar de um representante
        da literatura fantástica, uma novidade no vestibular.
      </p>
    </div>
    <div class="col-md-7 p-4">
      <p class="lead" style="font-size: 0.9em;"><br> (Pró-Reitor de Graduação da USP e membro do Conselho da
        Fundação, Aluísio Cotrim Segurado)
      </p>
    </div>
  </div>
</div>