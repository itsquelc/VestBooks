@model Livro
@{
    ViewData["Title"] = Model.Nome;
}

<section class="bg-white mt-100">
    <div class="container-fluid px-0">

        <!-- Cabeçalho com imagem e título -->
        <div class="bg-primary py-4">
            <div class="container text-center">
                <img src="@Model.Foto" alt="Capa do livro @Model.Nome" class="img-fluid" style="max-height: 200px;">
                <h2 class="text-white mt-3">@Model.Nome</h2>
                <p class="text-light mb-0">por <strong>@Model.Autor.Nome</strong></p>
            </div>
        </div>

        <!-- Informações gerais -->
        <div class="container mt-5 text-center">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <p><strong>Descrição:</strong> @Model.Descricao</p>
                    <p><strong>Publicação:</strong> @Model.Publicacao</p>
                    <p><strong>Avaliação:</strong> @Model.Avaliacao ⭐</p>
                    <p><strong>Tamanho:</strong> @Model.NumeroPaginas páginas</p>
                </div>
            </div>
        </div>

        <!-- Resumo -->
        <div class="text-center bg-info text-white py-2 my-4" style="font-weight: bold;">
            Resumo
        </div>

        <div class="container mt-4 mb-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="bg-white shadow rounded p-4">
                        <p class="lead text-justify">@Html.Raw(Model.Descricao)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vídeo Aula -->
        <div class="text-center bg-info text-white py-2 my-4" style="font-weight: bold;">
            Vídeo Aula
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-md-8">
                <div class="ratio ratio-16x9">
                    <iframe src="https://www.youtube.com/embed/@Model.Video"
                            title="Vídeo do livro @Model.Nome"
                            allowfullscreen>
                    </iframe>
                </div>
            </div>
        </div>

    </div>
</section>
